#!/bin/bash
# Auto-generated by experiments/claude/precond_v3/sweep.py
# Sweep: phase1_residual_up_20260501
# Experiment: residual_w1e-4_base32
# Pair: 32_64
# Hypothesis: small operator-weighted penalty improves solver-relevant high-frequency consistency without overwhelming field fit.
#SBATCH --job-name=phase1_residual_up_20260501__residual_w1e-4_base32__32_64
#SBATCH --output=/orcd/scratch/orcd/006/fkiewiet/freq2transfer/slurm_logs/%x_%j.log
#SBATCH --error=/orcd/scratch/orcd/006/fkiewiet/freq2transfer/slurm_logs/%x_%j.err
#SBATCH --time=12:00:00
#SBATCH --partition=mit_preemptable
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64G
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --signal=B:USR1@300

set -euo pipefail

ROOT="${SLURM_SUBMIT_DIR:-$HOME/Freq2Transfer}"
cd "$ROOT"

export CONFIG=experiments/claude/precond_v3/configs/pair_32_64.yaml
export DIRECTION=up
export MAX_RUNTIME_H=10.5
export NUM_WORKERS=0
export EXPERIMENT_OUTDIR=/orcd/scratch/orcd/006/fkiewiet/freq2transfer/precond_v3_sweeps/phase1_residual_up_20260501/residual_w1e-4_base32
export EXTRA_ARGS='--epochs 1000 --early_stop 10000 --lr_patience 40 --fresh --residual_weight 0.0001 --residual_kind helmholtz_error'
PAIR=32_64
RUN_DIR="$EXPERIMENT_OUTDIR/pair_$PAIR/T_$DIRECTION"
SELF_SCRIPT="$ROOT/experiments/claude/precond_v3/launch/generated/phase1_residual_up_20260501/phase1_residual_up_20260501__residual_w1e-4_base32__32_64.sbatch"
TARGET_EPOCHS=1000
AUTO_RESUBMIT=1
MAX_AUTO_RESUBMITS=20
AUTO_RESUBMIT_COUNT_FILE="$RUN_DIR/.auto_resubmit_count"

summary_field() {
  local field="$1"
  if [[ ! -f "$RUN_DIR/summary.json" ]]; then
    echo ""
    return 0
  fi
  python3 -c 'import json, sys; p, k = sys.argv[1:3]; print(json.load(open(p)).get(k, ""))' "$RUN_DIR/summary.json" "$field" || true
}

auto_resubmit_if_needed() {
  local trigger="$1"
  local status
  local last_epoch
  local target_last
  local count

  if [[ "$AUTO_RESUBMIT" != "1" ]]; then
    echo "[auto-resubmit] disabled"
    return 0
  fi

  mkdir -p "$RUN_DIR"
  status="$(summary_field stopped_reason)"
  last_epoch="$(summary_field last_epoch)"
  if [[ -z "$last_epoch" ]]; then
    last_epoch=-1
  fi
  target_last=$((TARGET_EPOCHS - 1))

  if [[ "$status" == "max_epochs" && "$last_epoch" -ge "$target_last" ]]; then
    echo "[auto-resubmit] complete: status=$status last_epoch=$last_epoch target_last=$target_last"
    return 0
  fi

  if [[ "$trigger" == "post_run" && "$status" != "runtime_cap" ]]; then
    echo "[auto-resubmit] not resubmitting after normal exit: status=${status:-missing} last_epoch=$last_epoch"
    return 0
  fi

  count=0
  if [[ -f "$AUTO_RESUBMIT_COUNT_FILE" ]]; then
    count="$(cat "$AUTO_RESUBMIT_COUNT_FILE" 2>/dev/null || echo 0)"
  fi
  if (( count >= MAX_AUTO_RESUBMITS )); then
    echo "[auto-resubmit] limit reached: $count / $MAX_AUTO_RESUBMITS"
    return 0
  fi

  count=$((count + 1))
  echo "$count" > "$AUTO_RESUBMIT_COUNT_FILE"
  echo "[auto-resubmit] submitting continuation #$count because trigger=$trigger status=${status:-missing} last_epoch=$last_epoch target_last=$target_last"
  sbatch "$SELF_SCRIPT"
}

on_usr1() {
  echo "[auto-resubmit] received Slurm USR1 pre-timeout signal at $(date)"
  auto_resubmit_if_needed "slurm_signal"
  exit 143
}
trap on_usr1 USR1

if [[ -f "$RUN_DIR/last.pt" && "$EXTRA_ARGS" == *"--fresh"* ]]; then
  echo "Existing checkpoint found at $RUN_DIR/last.pt"
  echo "Removing --fresh so this submission resumes instead of restarting."
  EXTRA_ARGS="${EXTRA_ARGS//--fresh/}"
fi

echo "run_id          : phase1_residual_up_20260501__residual_w1e-4_base32__32_64"
echo "hypothesis      : small operator-weighted penalty improves solver-relevant high-frequency consistency without overwhelming field fit."
echo "config          : $CONFIG"
echo "direction       : $DIRECTION"
echo "experiment root : $EXPERIMENT_OUTDIR"
echo "extra args      : $EXTRA_ARGS"
echo "auto resubmit   : $AUTO_RESUBMIT (max $MAX_AUTO_RESUBMITS)"
echo

set +e
bash experiments/claude/precond_v3/launch/sbatch_pair_up_staged.sh
train_rc=$?
set -e
trap - USR1

if [[ "$train_rc" -ne 0 ]]; then
  echo "[auto-resubmit] launcher failed with exit code $train_rc; not resubmitting automatically."
  exit "$train_rc"
fi

auto_resubmit_if_needed "post_run"
